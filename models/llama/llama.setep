// Llama 4 Maverick 17B-128E (text decoder)
// Source: https://github.com/meta-pytorch/torchtune/blob/main/torchtune/models/llama4/_model_builders.py
// Checked 2026-09-29. See README.md for sources, assumptions and limitations.
// BF16 text-only, stateless prefill; no KV cache, vision encoder or training.
// ALL-EXPERT UPPER-BOUND GRAPH: every expert processes every input token.
// active_experts affects the traffic estimate only; executable graphs stay all-expert.

tokens = 1
layers = 48
model_width = 5120
ff_width = 16384
expert_width = 8192
heads = 40
kv_heads = 8
head_dim = 128
vocab_size = 202048
experts = 128
active_experts = 1
query_width = 5120
kv_width = 1024
layer_groups = 12
attention_chunk_size = 8192

// Runtime hooks are shape contracts, not pretrained implementations.
embedding = vocab_size%model_width@bf16
lm_head = model_width%vocab_size@bf16
final_norm = 1%model_width@bf16

TOKEN_IN = tokens@int32
A = tokens%model_width@bf16
B = tokens%model_width@bf16
N = tokens%model_width@bf16
F = tokens%model_width@bf16
H = tokens%model_width@bf16
Q = tokens%query_width@bf16
K = tokens%kv_width@bf16
V = tokens%kv_width@bf16
QR = tokens%query_width@bf16
KR = tokens%kv_width@bf16
KE = tokens%query_width@bf16
VE = tokens%query_width@bf16
CORE = tokens%query_width@bf16
LOGITS = tokens%vocab_size@bf16

X = tokens%model_width@bf16
Y = tokens%model_width@bf16
Z = tokens%model_width@bf16
G = tokens%expert_width@bf16
U = tokens%expert_width@bf16
W = tokens%1@bf16
POSITIONS = tokens@int32
ASSIGNMENTS = tokens%active_experts@int32
PROBABILITIES = tokens%active_experts@bf16

// Separate parameter banks for each layer family within a repeated group.
dense_chunk_layer_attn_norm[layer_groups] = 1%model_width@bf16
dense_chunk_layer_dense_down[layer_groups] = ff_width%model_width@bf16
dense_chunk_layer_dense_gate[layer_groups] = model_width%ff_width@bf16
dense_chunk_layer_dense_up[layer_groups] = model_width%ff_width@bf16
dense_chunk_layer_ffn_norm[layer_groups] = 1%model_width@bf16
dense_chunk_layer_wk[layer_groups] = model_width%kv_width@bf16
dense_chunk_layer_wo[layer_groups] = query_width%model_width@bf16
dense_chunk_layer_wq[layer_groups] = model_width%query_width@bf16
dense_chunk_layer_wv[layer_groups] = model_width%kv_width@bf16

moe_chunk_layer_attn_norm[layer_groups] = 1%model_width@bf16
moe_chunk_layer_down = expert_width%model_width@bf16
moe_chunk_layer_ffn_norm[layer_groups] = 1%model_width@bf16
moe_chunk_layer_gate = model_width%expert_width@bf16
moe_chunk_layer_router[layer_groups] = model_width%experts@bf16
moe_chunk_layer_shared_down[layer_groups] = expert_width%model_width@bf16
moe_chunk_layer_shared_gate[layer_groups] = model_width%expert_width@bf16
moe_chunk_layer_shared_up[layer_groups] = model_width%expert_width@bf16
moe_chunk_layer_up = model_width%expert_width@bf16
moe_chunk_layer_wk[layer_groups] = model_width%kv_width@bf16
moe_chunk_layer_wo[layer_groups] = query_width%model_width@bf16
moe_chunk_layer_wq[layer_groups] = model_width%query_width@bf16
moe_chunk_layer_wv[layer_groups] = model_width%kv_width@bf16

dense_third_layer_attn_norm[layer_groups] = 1%model_width@bf16
dense_third_layer_dense_down[layer_groups] = ff_width%model_width@bf16
dense_third_layer_dense_gate[layer_groups] = model_width%ff_width@bf16
dense_third_layer_dense_up[layer_groups] = model_width%ff_width@bf16
dense_third_layer_ffn_norm[layer_groups] = 1%model_width@bf16
dense_third_layer_wk[layer_groups] = model_width%kv_width@bf16
dense_third_layer_wo[layer_groups] = query_width%model_width@bf16
dense_third_layer_wq[layer_groups] = model_width%query_width@bf16
dense_third_layer_wv[layer_groups] = model_width%kv_width@bf16

moe_nope_layer_attn_norm[layer_groups] = 1%model_width@bf16
moe_nope_layer_down = expert_width%model_width@bf16
moe_nope_layer_ffn_norm[layer_groups] = 1%model_width@bf16
moe_nope_layer_gate = model_width%expert_width@bf16
moe_nope_layer_router[layer_groups] = model_width%experts@bf16
moe_nope_layer_shared_down[layer_groups] = expert_width%model_width@bf16
moe_nope_layer_shared_gate[layer_groups] = model_width%expert_width@bf16
moe_nope_layer_shared_up[layer_groups] = model_width%expert_width@bf16
moe_nope_layer_up = model_width%expert_width@bf16
moe_nope_layer_wk[layer_groups] = model_width%kv_width@bf16
moe_nope_layer_wo[layer_groups] = query_width%model_width@bf16
moe_nope_layer_wq[layer_groups] = model_width%query_width@bf16
moe_nope_layer_wv[layer_groups] = model_width%kv_width@bf16

// Default cost placeholder: selected embedding rows need token-dependent read accounting.
EMBED(TOKEN_IN:A) {}

// Uncalibrated cost estimate; omitted fields use the abstract defaults.
RMSNORM(A:B) {ops_per_element = 5}

// Uncalibrated estimate: Two multiplies and one add per Q/K element; assumes precomputed sin/cos, whose reads are not modeled.
ROPE_PAIR(Q:K) {ops_per_element = 3}

// Copy estimate: zero arithmetic, one input read/output write. A view may avoid these accesses.
EXPAND_KV(KK:VV) {ops_per_element = 0}

SCALE_CHUNK_MASK(A) {}

DENSE_CHUNK_LAYER_CORE_CHUNK(QQ:KK:VV) {
    KK:VV >> EXPAND_KV() >> KE:VE;
    QQ:KE:VE >[heads]> QH:KH:VH;
    REPEAT/heads[]{QH[]*KH[]^ >> SCALE_CHUNK_MASK() >> SOFTMAX_LAST() >> *VH[]} >[]> CORE
}

DENSE_CHUNK_LAYER_ATTENTION_CHUNK(A) {
    {A*dense_chunk_layer_wq} >> Q;
    {A*dense_chunk_layer_wk} >> K;
    {A*dense_chunk_layer_wv} >> V;
    Q:K >> ROPE_PAIR() >> QR:KR;
    QR:KR:V >> DENSE_CHUNK_LAYER_CORE_CHUNK() >> CORE;
    {CORE*dense_chunk_layer_wo} >> B
}

// Uncalibrated estimate: Five scalar operations per element; exp/div each count as one, not calibrated hardware latency.
SILU(A) {ops_per_element = 5}

DENSE_CHUNK_LAYER_DENSE_FF(A) {
    A*dense_chunk_layer_dense_gate >> SILU() >> DG;
    A*dense_chunk_layer_dense_up >> DU;
    DG:DU >> MUL_ELEMENTS() >> DT;
    DT*dense_chunk_layer_dense_down >> B
}

DENSE_CHUNK_LAYER(A) {
    A:dense_chunk_layer_attn_norm >> RMSNORM() >> N;
    N >> DENSE_CHUNK_LAYER_ATTENTION_CHUNK() >> D;
    A+D >> H;
    H:dense_chunk_layer_ffn_norm >> RMSNORM() >> N;
    N >> DENSE_CHUNK_LAYER_DENSE_FF() >> F;
    H+F >> B
}

MOE_CHUNK_LAYER_CORE_CHUNK(QQ:KK:VV) {
    KK:VV >> EXPAND_KV() >> KE:VE;
    QQ:KE:VE >[heads]> QH:KH:VH;
    REPEAT/heads[]{QH[]*KH[]^ >> SCALE_CHUNK_MASK() >> SOFTMAX_LAST() >> *VH[]} >[]> CORE
}

MOE_CHUNK_LAYER_ATTENTION_CHUNK(A) {
    {A*moe_chunk_layer_wq} >> Q;
    {A*moe_chunk_layer_wk} >> K;
    {A*moe_chunk_layer_wv} >> V;
    Q:K >> ROPE_PAIR() >> QR:KR;
    QR:KR:V >> MOE_CHUNK_LAYER_CORE_CHUNK() >> CORE;
    {CORE*moe_chunk_layer_wo} >> B
}

// Default cost placeholder: routing selection costs depend on expert count and selection algorithm.
ROUTER(A) {}

// Payload-copy estimate: zero arithmetic, default reads/writes; indexing, selection and zero-fill costs omitted.
DISPATCH(A:B:C) {ops_per_element = 0}

MOE_CHUNK_LAYER_EXPERT(A) {
    A*moe_chunk_layer_gate[] >> SILU() >> G;
    A*moe_chunk_layer_up[] >> U;
    G:U >> MUL_ELEMENTS() >> T;
    T*moe_chunk_layer_down[] >> B
}

SCALE_ROUTED(Y:W) {}

// Payload-copy estimate: zero arithmetic, default reads/writes; indexing, selection and zero-fill costs omitted.
SCATTER(Y:POSITIONS:A) {ops_per_element = 0}

MOE_CHUNK_LAYER_SHARED_EXPERT(A) {
    A*moe_chunk_layer_shared_gate >> SILU() >> G;
    A*moe_chunk_layer_shared_up >> U;
    G:U >> MUL_ELEMENTS() >> T;
    T*moe_chunk_layer_shared_down >> B
}

MOE_CHUNK_LAYER_MOE(A) {
    {A*moe_chunk_layer_router} >> ROUTER() >> ASSIGNMENTS:PROBABILITIES;
    A:ASSIGNMENTS:PROBABILITIES >> REPEAT/experts[]{
        DISPATCH[]() >> X:W:POSITIONS;
        X >> MOE_CHUNK_LAYER_EXPERT[]() >> Y;
        Y:W >> SCALE_ROUTED() >> Y;
        Y:POSITIONS:A >> SCATTER() >> Z
    } >+[]> R;
    A >> MOE_CHUNK_LAYER_SHARED_EXPERT() >> S;
    R+S >> B
}

MOE_CHUNK_LAYER(A) {
    A:moe_chunk_layer_attn_norm >> RMSNORM() >> N;
    N >> MOE_CHUNK_LAYER_ATTENTION_CHUNK() >> D;
    A+D >> H;
    H:moe_chunk_layer_ffn_norm >> RMSNORM() >> N;
    N >> MOE_CHUNK_LAYER_MOE() >> F;
    H+F >> B
}

DENSE_THIRD_LAYER_CORE_CHUNK(QQ:KK:VV) {
    KK:VV >> EXPAND_KV() >> KE:VE;
    QQ:KE:VE >[heads]> QH:KH:VH;
    REPEAT/heads[]{QH[]*KH[]^ >> SCALE_CHUNK_MASK() >> SOFTMAX_LAST() >> *VH[]} >[]> CORE
}

DENSE_THIRD_LAYER_ATTENTION_CHUNK(A) {
    {A*dense_third_layer_wq} >> Q;
    {A*dense_third_layer_wk} >> K;
    {A*dense_third_layer_wv} >> V;
    Q:K >> ROPE_PAIR() >> QR:KR;
    QR:KR:V >> DENSE_THIRD_LAYER_CORE_CHUNK() >> CORE;
    {CORE*dense_third_layer_wo} >> B
}

DENSE_THIRD_LAYER_DENSE_FF(A) {
    A*dense_third_layer_dense_gate >> SILU() >> DG;
    A*dense_third_layer_dense_up >> DU;
    DG:DU >> MUL_ELEMENTS() >> DT;
    DT*dense_third_layer_dense_down >> B
}

DENSE_THIRD_LAYER(A) {
    A:dense_third_layer_attn_norm >> RMSNORM() >> N;
    N >> DENSE_THIRD_LAYER_ATTENTION_CHUNK() >> D;
    A+D >> H;
    H:dense_third_layer_ffn_norm >> RMSNORM() >> N;
    N >> DENSE_THIRD_LAYER_DENSE_FF() >> F;
    H+F >> B
}

SCALE_CAUSAL_MASK(A) {}

MOE_NOPE_LAYER_CORE_FULL(QQ:KK:VV) {
    KK:VV >> EXPAND_KV() >> KE:VE;
    QQ:KE:VE >[heads]> QH:KH:VH;
    REPEAT/heads[]{QH[]*KH[]^ >> SCALE_CAUSAL_MASK() >> SOFTMAX_LAST() >> *VH[]} >[]> CORE
}

MOE_NOPE_LAYER_ATTENTION_NOPE(A) {
    {A*moe_nope_layer_wq} >> Q;
    {A*moe_nope_layer_wk} >> K;
    {A*moe_nope_layer_wv} >> V;
    Q:K:V >> MOE_NOPE_LAYER_CORE_FULL() >> CORE;
    {CORE*moe_nope_layer_wo} >> B
}

MOE_NOPE_LAYER_EXPERT(A) {
    A*moe_nope_layer_gate[] >> SILU() >> G;
    A*moe_nope_layer_up[] >> U;
    G:U >> MUL_ELEMENTS() >> T;
    T*moe_nope_layer_down[] >> B
}

MOE_NOPE_LAYER_SHARED_EXPERT(A) {
    A*moe_nope_layer_shared_gate >> SILU() >> G;
    A*moe_nope_layer_shared_up >> U;
    G:U >> MUL_ELEMENTS() >> T;
    T*moe_nope_layer_shared_down >> B
}

MOE_NOPE_LAYER_MOE(A) {
    {A*moe_nope_layer_router} >> ROUTER() >> ASSIGNMENTS:PROBABILITIES;
    A:ASSIGNMENTS:PROBABILITIES >> REPEAT/experts[]{
        DISPATCH[]() >> X:W:POSITIONS;
        X >> MOE_NOPE_LAYER_EXPERT[]() >> Y;
        Y:W >> SCALE_ROUTED() >> Y;
        Y:POSITIONS:A >> SCATTER() >> Z
    } >+[]> R;
    A >> MOE_NOPE_LAYER_SHARED_EXPERT() >> S;
    R+S >> B
}

MOE_NOPE_LAYER(A) {
    A:moe_nope_layer_attn_norm >> RMSNORM() >> N;
    N >> MOE_NOPE_LAYER_ATTENTION_NOPE() >> D;
    A+D >> H;
    H:moe_nope_layer_ffn_norm >> RMSNORM() >> N;
    N >> MOE_NOPE_LAYER_MOE() >> F;
    H+F >> B
}

FOUR_LAYERS(A) {A >> DENSE_CHUNK_LAYER[]() >> MOE_CHUNK_LAYER[]() >> DENSE_THIRD_LAYER[]() >> MOE_NOPE_LAYER[]() >> B}

LLAMA(TOKEN_IN) {
    TOKEN_IN:embedding >> EMBED() >> A;
    A >> REPEAT/layer_groups{FOUR_LAYERS[]()} >> H;
    H:final_norm >> RMSNORM() >> N;
    N*lm_head >> LOGITS
}
