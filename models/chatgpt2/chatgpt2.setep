// ============================================================
// CHATGPT2 INFERENCE
// ============================================================
//
// CHECKPOINT INTEGRATION NOTES (chatgpt2.safetensors)
// The checkpoint matches 12 layers, width 768, MLP width 3072,
// and vocabulary size 50257. Loading weights alone is insufficient;
// the bias and padding changes below are also needed for faithful inference.
//
// Weight mapping for each block N:
//   wte.weight -> token embeddings, shape 50257%768.
//   wpe.weight -> position embeddings, shape 1024%768.
//     The current token count uses only part of this position capacity.
//   h.N.attn.c_attn.weight -> split its 768%2304 columns into q, k, v.
//   h.N.attn.c_proj.weight -> o, shape 768%768.
//   h.N.mlp.c_fc.weight -> up, shape 768%3072.
//   h.N.mlp.c_proj.weight -> down, shape 3072%768.
//   These projection matrices already have the required orientation.
//   h.N.ln_1.weight[bias] -> first LN in block N.
//   h.N.ln_2.weight[bias] -> second LN in block N.
//   ln_f.weight[bias] -> final LN after all blocks.
//
// Projection computations below add the checkpoint's nonzero biases:
//   Split h.N.attn.c_attn.bias (2304) into q[k]/v biases (768 each).
//   Add each bias after its corresponding q[k]/v matrix multiplication.
//   Add h.N.attn.c_proj.bias (768) after the o projection.
//   Add h.N.mlp.c_fc.bias (3072) after up and before GELU.
//   Add h.N.mlp.c_proj.bias (768) after down.
//   All of these biases must be distinct per block.
//
// TOKEN_WEIGHTS gives embeddings and the language-model head one weight bank.
//   The checkpoint has no separate language-model head tensor.
//   Use wte.weight transposed (768%50257), preserving shared ownership.
//
// TOKENIZE carries a padding mask into attention and position IDs into EMBED.
//   Exclude padding keys in addition to applying the causal attention mask.
//   Assign real prompt tokens position IDs starting at zero, independent
//   of the number of left-padding tokens. Handle an empty prompt explicitly.
//   h.N.attn.bias contains the stored causal mask, not a learned bias;
//   the implementation may reconstruct it for the current sequence length.

// ============================================================
// CHATGPT2 PREFILL + AUTOREGRESSIVE DECODE
// ============================================================

text_in = 100
tokens = 10
decode_tokens = 10
positions = 1024
layers = 12
heads = 12
model_width = 768
mlp_width = 3072
vocab_size = 50257

TEXT_IN = text_in@int8
// TEXT_OUT has variable length: prompt bytes plus generated bytes.
// Its shape is inferred from the final concatenation.

TOKEN_IN = tokens@int32
TOKEN = 1@int32

ATTENTION_MASK = tokens@int32
POSITION_IDS = tokens@int32

q[layers] = model_width%model_width@fp32
k[layers] = model_width%model_width@fp32
v[layers] = model_width%model_width@fp32
o[layers] = model_width%model_width@fp32

up[layers] = model_width%mlp_width@fp32
down[layers] = mlp_width%model_width@fp32

wte = vocab_size%model_width@fp32
wpe = positions%model_width@fp32

qb[layers] = 1%model_width@fp32
kb[layers] = 1%model_width@fp32
vb[layers] = 1%model_width@fp32
ob[layers] = 1%model_width@fp32

up_bias[layers] = 1%mlp_width@fp32
down_bias[layers] = 1%model_width@fp32


// ============================================================
// ABSTRACT AND SIMPLE COMPUTATIONS
// ============================================================

DETOKENIZE(TOKENS) {}
// Uncalibrated cost estimate; omitted fields use the abstract defaults.
LN(X) {ops_per_element = 8}
// Uncalibrated cost estimate; omitted fields use the abstract defaults.
SOFTMAX(SCORES:ATTENTION_MASK) {ops_per_element = 5}
// Uncalibrated estimate: Tanh approximation: nine scalar operations per element; tanh counts as one, not calibrated latency.
GELU(A) {ops_per_element = 9}
SAMPLE(A) {}
TOKENIZE(TEXT_IN) {}
DECODE_PREP(TOKEN) {}
// Default cost placeholder: selected embedding rows need token-dependent read accounting.
LOOKUP(IDS:A) {}
MLP(A) { A >> *up +up_bias >> GELU() >> *down +down_bias >> B }

// Shared embedding tables also supply the language-model head.
TOKEN_WEIGHTS() {wte}
POSITION_WEIGHTS() {wpe}

EMBED(IDS:POSITIONS) {
    IDS:TOKEN_WEIGHTS() >> LOOKUP() >> T;
    POSITIONS:POSITION_WEIGHTS() >> LOOKUP() >> PE;
    T+PE >> B
}

LMHEAD(A) {
    TOKEN_WEIGHTS() >> W;
    A*W^ >> B
}

// PREFILL creates one persistent K!/V! cache per named BLOCK instance.
PREFILL(TOKEN_IN:ATTENTION_MASK:POSITION_IDS) {
    TOKEN_IN:POSITION_IDS >> EMBED() >> X;
    BLOCK/layers{
        X >> LN[]() >> *q[]:k[]:v[] +qb[]:kb[]:vb[] >> Q:K:V;
        K >> K!;
        V >> V!;
        Q:K!:V! >[heads]> Q_HEAD:K_HEAD:V_HEAD;
        REPEAT/heads[]{
            Q_HEAD[]*K_HEAD[]^ >> SCORES;
            SCORES:ATTENTION_MASK >> SOFTMAX() >> PROBS;
            PROBS*V_HEAD[]
        } >[]> *o[] +ob[] >> D;
        D+X >> E >> LN[]() >> MLP[]() >> G;
        G+E >> X
    };
    X >> LN() >> LMHEAD() >> SAMPLE() >> TOKEN
}

// Matching named BLOCK scopes reuse the prefill caches by layer index.
// Each step appends new keys[values] along the sequence dimension.
DECODE(TOKEN) {
    TOKEN >> DECODE_PREP() >> TOK:MASK:POSITION;
    TOK:POSITION >> EMBED() >> X;
    BLOCK/layers{
        X >> LN[]() >> *q[]:k[]:v[] +qb[]:kb[]:vb[] >> Q:K:V;
        K!^:K^ >:> NEXT_K;
        NEXT_K^ >> K!;
        V!^:V^ >:> NEXT_V;
        NEXT_V^ >> V!;
        Q:K!:V! >[heads]> Q_HEAD:K_HEAD:V_HEAD;
        REPEAT/heads[]{
            Q_HEAD[]*K_HEAD[]^ >> SCORES;
            SCORES:MASK >> SOFTMAX() >> PROBS;
            PROBS*V_HEAD[]
        } >[]> *o[] +ob[] >> D;
        D+X >> E >> LN[]() >> MLP[]() >> G;
        G+E >> X
    };
    X >> LN() >> LMHEAD() >> SAMPLE() >> TOKEN
}

// Prefill predicts one token; the sequential loop predicts decode_tokens more.
// TOKEN and TOKENS are updated by name across decode iterations.
CHATGPT2_INFERENCE(TEXT_IN) {
    TEXT_IN >> TOKENIZE() >> TOKEN_IN:ATTENTION_MASK:POSITION_IDS
        >> PREFILL() >> TOKEN;
    TOKEN >> TOKENS;
    REPEAT/decode_tokens{
        TOKEN >> DECODE() >> TOKEN;
        TOKENS:TOKEN >:> TOKENS
    };
    TOKENS >> DETOKENIZE() >> NEW_TEXT;
    TEXT_IN:NEW_TEXT >:> TEXT_OUT
}
